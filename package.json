{
  "name": "p2pa",
  "version": "0.7.0",
  "description": "P2PA \u2014 headless P2P context synchronization for local AI agents (MCP + Hyperswarm + JSON Patch)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "p2pa": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "p2pa",
    "mcp",
    "p2p",
    "hyperswarm",
    "ai-agents",
    "json-patch",
    "cursor",
    "claude",
    "multi-agent"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "smoke": "tsx scripts/smoke-p2p.ts",
    "smoke:doc": "tsx scripts/smoke-doc.ts",
    "smoke:merge": "tsx scripts/smoke-merge.ts",
    "smoke:claim": "tsx scripts/smoke-claim.ts",
    "smoke:outbox": "tsx scripts/smoke-outbox.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-json-patch": "^3.1.1",
    "googleapis": "^173.0.0",
    "hyperdht": "^6.21.0",
    "hyperswarm": "^4.17.0",
    "pm2": "^6.0.8",
    "yargs": "^18.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
